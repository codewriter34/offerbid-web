# OfferBid Web Environment
# Local API (docker postgres + nest). For Render stage / Netlify, use:
# NEXT_PUBLIC_API_BASE_URL=https://offerbid-api.onrender.com/api/v1
# NEXT_PUBLIC_SOCKET_URL=wss://offerbid-api.onrender.com/realtime
NEXT_PUBLIC_API_BASE_URL=http://localhost:3009/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3009/realtime
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Required for Sign in / Sign up with Google (GIS button).
# Must be the Web client ID from the same Firebase project as the API.
# Without it the auth page shows a labeled but disabled Google button.
#
# Nest verifies Firebase ID tokens. After GIS, the web app exchanges the
# Google credential for a Firebase ID token, then POST /auth/google.
# Firebase Console → Project settings → Your apps → Web app:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=offerbid-59cd9.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=offerbid-59cd9
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Netlify site env (Site configuration → Environment variables, all contexts):
# NEXT_PUBLIC_API_BASE_URL=https://offerbid-api.onrender.com/api/v1
# NEXT_PUBLIC_SOCKET_URL=wss://offerbid-api.onrender.com/realtime
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=<Google OAuth Web Client ID>
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=offerbid-59cd9.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=offerbid-59cd9
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_APP_URL=https://<site>.netlify.app
